import XCTest

final class {{PROJECT_NAME_PASCAL}}UITests: XCTestCase {

    /// Maximum time to wait for benchmark completion (5 minutes for long benchmarks)
    private let defaultBenchmarkTimeout: TimeInterval = {{IOS_BENCHMARK_TIMEOUT_SECS}}.0

    private var benchmarkTimeout: TimeInterval {
        if let configuredTimeout =
            ProcessInfo.processInfo.environment["MOBENCH_IOS_BENCHMARK_TIMEOUT_SECS"],
            let parsedTimeout = TimeInterval(configuredTimeout),
            parsedTimeout > 0
        {
            return parsedTimeout
        }

        return defaultBenchmarkTimeout
    }

    private func isBenchmarkCompleted(_ element: XCUIElement) -> Bool {
        guard element.exists else {
            return false
        }

        let rawLabel = element.label
        let rawValue = element.value as? String ?? ""
        return rawLabel == "completed" || rawValue == "completed"
    }

    private func reportPayload(from element: XCUIElement) -> String {
        guard element.exists else {
            return ""
        }

        let rawValue = element.value as? String ?? ""
        let rawLabel = element.label
        if rawValue.hasPrefix("{") || rawValue.contains("\"error\"") {
            return rawValue
        }
        if rawLabel.hasPrefix("{") || rawLabel.contains("\"error\"") {
            return rawLabel
        }

        return ""
    }

    func testLaunchAndCaptureBenchmarkReport() {
        let app = XCUIApplication()
        app.launch()

        // Poll instead of using one long wait so BrowserStack receives regular XCUITest output.
        let completedIndicator = app.staticTexts["benchmarkCompleted"]
        let reportElement = app.staticTexts["benchmarkReportJSON"]
        let deadline = Date().addingTimeInterval(benchmarkTimeout)
        var completed = false
        var jsonString = ""

        while Date() < deadline {
            completed = completed || isBenchmarkCompleted(completedIndicator)
            if jsonString.isEmpty {
                jsonString = reportPayload(from: reportElement)
            }
            if completed && !jsonString.isEmpty {
                break
            }

            let elapsed = benchmarkTimeout - deadline.timeIntervalSinceNow
            NSLog("BENCH_HEARTBEAT_JSON {\"schema_version\":1,\"platform\":\"ios\",\"elapsed_ms\":\(Int(elapsed * 1000))}")
            print("BENCH_HEARTBEAT_JSON {\"schema_version\":1,\"platform\":\"ios\",\"elapsed_ms\":\(Int(elapsed * 1000))}")
            Thread.sleep(forTimeInterval: min(10.0, max(0.5, deadline.timeIntervalSinceNow)))
        }
        XCTAssertTrue(completed, "Benchmark should complete within \(benchmarkTimeout) seconds")

        // Wait 5 seconds so BrowserStack video captures the results
        // This delay is critical for video evidence of benchmark completion
        Thread.sleep(forTimeInterval: 5.0)

        // Extract the benchmark report JSON from the hidden element
        XCTAssertTrue(reportElement.exists, "Benchmark report JSON element should exist after completion")
        jsonString = jsonString.isEmpty ? reportPayload(from: reportElement) : jsonString

        // Log with markers that mobench fetch can parse from instrumentation logs
        // Using NSLog to ensure it goes to device logs that BrowserStack captures
        NSLog("BENCH_REPORT_JSON_START")
        NSLog("%@", jsonString)
        NSLog("BENCH_REPORT_JSON_END")

        // Also print to stdout for local testing visibility
        print("BENCH_REPORT_JSON_START")
        print(jsonString)
        print("BENCH_REPORT_JSON_END")

        // Verify we got valid JSON (not an error message)
        XCTAssertFalse(jsonString.isEmpty, "Benchmark report JSON should not be empty")
        XCTAssertTrue(jsonString.hasPrefix("{"), "Benchmark report should be valid JSON (starts with '{')")
        XCTAssertFalse(jsonString.contains("\"error\""), "Benchmark report should not be an error payload: \(jsonString)")
    }

    // Keep the old test name for backward compatibility
    func testLaunchShowsBenchmarkReport() {
        testLaunchAndCaptureBenchmarkReport()
    }
}
